# 云智助手 2api 环境变量示例(Docker / 本机通用)
# 复制为 .env 后修改:
#   - Docker 部署: docker compose up -d --build
#   - 本机运行: 由 run.py 读取 config.yaml,环境变量仅作覆盖(CTYUN_DATA_DIR 请留空)

# ============ 管理员(必改) ============
# 后台密码(首次启动会 bcrypt 入库)
CTYUN_ADMIN_PASSWORD=请替换为高强度密码

# 后台用户名(默认 admin)
CTYUN_ADMIN_USERNAME=admin

# session 加密密钥(留空时自动生成并持久化到数据卷)
# 生成: python -c "import secrets;print(secrets.token_urlsafe(32))"
CTYUN_ADMIN_SECRET=

# HTTPS 部署保持 true；仅本机纯 HTTP 调试时设为 false
CTYUN_ADMIN_SECURE_COOKIE=true

# ============ 服务监听 ============
# 监听地址
CTYUN_HOST=0.0.0.0

# 监听端口(容器内固定 10088;本机直接使用)
CTYUN_PORT=10088

# ============ 数据存储 ============
# 数据目录:SQLite 数据库 + 日志都存这里
#   - Docker: 必须是 /app/data(已挂载命名卷 yzzs-data,持久化)
#   - 本机: 请留空 → 使用默认 ./data
CTYUN_DATA_DIR=/app/data

# SQLite 路径(留空则由 CTYUN_DATA_DIR 推导为 {CTYUN_DATA_DIR}/ctyun.db)
CTYUN_DB_URL=

# 日志级别
CTYUN_LOG_LEVEL=INFO

# ============ Docker Compose 专属 ============
# 宿主映射端口(仅 docker-compose.yml 使用,默认 10087)
# 被占用时改这里,如 11088
YZZS_PORT=10087

# 2api -> ToolForge 上游访问密钥（需先在 2api 后台创建同名 API Key）
YZZS_API_KEY=
# 客户端访问 ToolForge 的密钥
TOOLFORGE_API_KEY=
# ToolForge 宿主机端口
TOOLFORGE_PORT=10090
